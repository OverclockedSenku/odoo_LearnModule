<odoo>
    <record id="view_mrp_production_tree_inherit_estimated_time" model="ir.ui.view">
        <field name="name">mrp.production.tree.inherit._estimated.time</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="estimated_total_time" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_mrp_production_fourm_inherit_estimated_time" model="ir.ui.view">
        <field name="name">mrp.production.fourm.inherit._estimated.time</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="estimated_time"/>
                <field name="estimated_total_time" readonly="True"/>
            </xpath>
        </field>
    </record>

<record id="mrp_production_form_estimated_time_button"
        model="ir.ui.view">
    <field name="name">mrp.production.estimated.time.button</field>
    <field name="model">mrp.production</field>
    <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
    <field name="arch" type="xml">

        <xpath expr="//div[@name='button_box']" position="inside">
            <button name="action_show_estimated_time"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-clock-o"
                    string="Estimated Time"
                    help="View the estimated manufacturing time">

                <div class="o_stat_info">
                    <span class="o_stat_value">
                        <field name="estimated_total_time"/>
                    </span>
                    <span class="o_stat_text">
                        Estimated Time (min)
                    </span>
                </div>
            </button>
        </xpath>

    </field>
</record>



<record id="product_template_form_estimated_time" model="ir.ui.view">
    <field name="name">product.template.form.estimated.time</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_only_form_view"/>
    <field name="arch" type="xml">
        <xpath expr="//sheet/notebook" position="before">
            <group string="Manufacturing">
                <field name="estimated_time_per_unit"/>
            </group>
        </xpath>
    </field>
</record>
</odoo>   
